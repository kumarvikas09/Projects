   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Dog Sizes</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">This ultra-flat vector infographic displays the profiles of twenty-eight common canine breeds, including dachshunds and boxers. All black silhouettes are isolated on a pure white background for versatility.</rdf:li>
    </rdf:Alt>
   </dc:description>
